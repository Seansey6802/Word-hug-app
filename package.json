{
  "name": "word-hug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Word Hug \u2014 Sometimes you just need a Word Hug. (Prototype, demo data only)",
  "scripts": {
    "dev": "next dev",
    "dev:phone": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run seed:demo",
    "seed:demo": "node --env-file=.env.local --experimental-strip-types scripts/seed-demo.ts",
    "test:db": "node --env-file=.env.local --experimental-strip-types --test --test-concurrency=1 tests/db/*.test.ts",
    "test:api": "node --env-file=.env.local --experimental-strip-types --test --test-concurrency=1 tests/api/*.test.ts",
    "test:e2e": "node --env-file=.env.local tests/e2e/run.cjs",
    "staff:add": "node --env-file=.env.local --experimental-strip-types scripts/staff-add.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "pg": "^8.23.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3"
  }
}
