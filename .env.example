# Word Hug prototype configuration. Copy to .env.local.
# Nothing here enables real payments or paid APIs.

# Passcode for the founder's studio at /studio
STUDIO_PASSCODE=demo-studio

# Payments: "demo" only during the prototype. Stripe is intentionally not wired up.
PAYMENTS_MODE=demo

# Storage: "local" keeps everything in ./.data (git-ignored). Supabase comes later.
STORAGE_MODE=local

# Future (do not fill in during prototype):
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
