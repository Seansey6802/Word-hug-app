# Word Hug configuration. Copy to .env.local for local development.
# Nothing here enables real payments or paid services.
#
# LOCAL: `npm run db:start` prints the local values (they are public defaults).
# STAGING/PRODUCTION: set these as encrypted environment variables in the host.
# Never commit real values or paste them into chat.

# Postgres as the least-privilege app role (NOT the postgres superuser).
# Hosted: Supabase pooler, transaction mode, e.g.
#   postgresql://wordhug_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://wordhug_app:wordhug-local-dev-only@127.0.0.1:54322/postgres

# Supabase Storage (private buckets) + Auth admin checks. Server-side only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Origin put into signed media links. Locally, set to http://<your-LAN-IP>:54321 to test on an iPhone.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321

# Founder sign-in (individual accounts + authenticator-app MFA, via Supabase Auth).
# The publishable key is public by design. Create founders with: npm run staff:add -- you@example.com
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Transactional email (recovery links). Locally: Mailpit, viewable at http://127.0.0.1:54324
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM="Word Hug <hello@wordhug.local>"
APP_URL=http://localhost:3000

# Hourly maintenance job (photo + video expiry, orphan cleanup, holds): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-string

# Payments: "fake" (local, no network) or "stripe_test" (Stripe TEST mode).
# There is no live mode. Live keys (sk_live_/rk_live_) are refused in code.
PAYMENTS_MODE=fake
# Only for PAYMENTS_MODE=stripe_test — a TEST key, never a live one:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen` or the test-mode webhook endpoint)
